projection;
strict ( 2 );

define behavior for ZC_Room //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use association _Equipos { create; }
  use association _Reservations { create; }
}

define behavior for ZC_Equipo //alias <alias_name>
{
  use update;
  use delete;

  use association _Room;
}

define behavior for ZC_Reserva //alias <alias_name>
{
  use update;
  use delete;

  use action CancelReservation;

  use association _Room;
}